**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets.
#
# The Supabase *publishable* key is safe in this repo -- it is built for
# client-side use and RLS is what actually protects the data. A service_role /
# sb_secret_* key is not: it bypasses RLS entirely, and a Flutter web build
# ships its source to every visitor. Nothing below should ever be committed.
.env
.env.*
*.secret
**/service_role*
**/*sb_secret*
supabase/.temp/
